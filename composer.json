{
    "name": "estuardoquan/laravel-auth",
    "description": "Minimal Laravel authentication scaffolding for Blade and Inertia Vue (JavaScript and TypeScript).",
    "keywords": [
        "laravel",
        "auth",
        "inertia",
        "vue",
        "blade"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/estuardoquan/laravel-auth/issues",
        "source": "https://github.com/estuardoquan/laravel-auth"
    },
    "authors": [
        {
            "name": "Estuardo Quan"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "symfony/console": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "orchestra/testbench-core": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EQ\\Laravel\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EQ\\Laravel\\Auth\\AuthServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
